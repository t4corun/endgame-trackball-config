/*
 * Polling Rate Setting Overrides
 *
 * 0ms: No delay? report as fast as possible
 * 1ms: 1000Hz
 * 2ms: 500Hz
 * 4ms: 250Hz
 * 8ms: 125Hz
 */
&rrl {
    values-ms = <0 1 2 4 8>;
};


/*
 * Pixart 3395 Overrides
 *
 * Default: 3200
 * Range is 50-25600 in 50 CPI increments
 */
&trackball_primary {
	cpi = <4000>;
};

&trackball_secondary {
	cpi = <4000>;
};



/*
 * Pointer and Twist Scaling
 *
 * How it is used:
 *   ( step * step increment ) / 1000
 *   then multiply this by CPI
 * 
 * Effective CPI
 *   2 >> 0.2 >>  800 CPI
 *   3 >> 0.3 >> 1200 CPI
 *   4 >> 0.4 >> 1600 CPI
 *   5 >> 0.5 >> 2000 CPI
 */
&sens {
    step = <100>;
    min-step = <2>;
    max-step = <5>;
};

&scrlsens {
    step = <100>;
    min-step = <2>;
    max-step = <5>;
};
