/*
 * Polling Rate Setting Overrides
 *
 * 0ms: No delay? report as fast as possible
 * 1ms: 1000Hz
 * 2ms: 500Hz
 * 4ms: 250Hz
 * 8ms: 125Hz
 */
&rrl {
    values-ms = <0 1 2 4 8>;
};


/*
 * Pixart 3395 Overrides
 *
 * Default: 3200
 * Range is 50-25600 in 50 CPI increments
 */
&trackball_primary {
	cpi = <8000>;
};

&trackball_secondary {
	cpi = <8000>;
};



/*
 * Pointer and Twist Scaling
 *
 * How it is used:
 *   ( step * step increment ) / 1000
 *   then multiply this by CPI
 * 
 * Effective CPI
 *   3  >> 0.15 >> 1200 CPI
 *   4* >> 0.2  >> 1600 CPI
 *   5  >> 0.25 >> 2000 CPI
 *   6  >> 0.3  >> 2400 CPI (twist 480)
 *   7* >> 0.35 >> 2800 CPI (twist 560)
 *   8  >> 0.4  >> 3200 CPI (twist 640)
 */
&sens {
    step = <50>;
    min-step = <3>;
    max-step = <6>;
};

&scrlsens {
    step = <50>;
    min-step = <6>;
    max-step = <9>;
};
